{
  "$schema": "./node_modules/fallow/schema.json",
  "entry": [
    "src/index.ts",
    "src/interfaces/cli.ts",
    "src/interfaces/serve.ts",
    "ui/main.tsx",
    "examples/*.ts",
    "test/*.test.ts",
    "test/*.spec.ts",
    "test/map/*.test.mjs",
    "src/client.ts",
    "src/interfaces/headless-server.ts",
    "scripts/register.mjs"
  ],
  "rules": {
    "complexity-cyclomatic": "error",
    "complexity-cognitive": "error",
    "complexity-crap": "error",
    "policy-violation": "error"
  },
  "boundaries": {
    "zones": [
      {
        "name": "headless-client",
        "patterns": ["src/client.ts"]
      },
      {
        "name": "public-api",
        "patterns": ["src/index.ts"]
      },
      {
        "name": "core",
        "patterns": ["src/core/**"]
      },
      {
        "name": "repository-contract",
        "patterns": ["src/application/ports/**"]
      },
      {
        "name": "application",
        "patterns": ["src/application/**"]
      },
      {
        "name": "persistence",
        "patterns": ["src/persistence/**"]
      },
      {
        "name": "api-contract",
        "patterns": [
          "src/interfaces/api-contract.ts",
          "src/interfaces/coverage-decoders.ts",
          "src/interfaces/working-context-decoders.ts",
          "src/interfaces/decode.ts",
          "src/interfaces/api-errors.ts",
          "src/interfaces/api-endpoints.ts",
          "src/interfaces/api-models.ts",
          "src/interfaces/api/**",
          "src/interfaces/api-capabilities.ts",
          "src/interfaces/api-compatibility.ts",
          "src/interfaces/api-reference.ts"
        ]
      },
      {
        "name": "launcher",
        "patterns": ["src/interfaces/serve.ts"]
      },
      {
        "name": "interfaces",
        "patterns": ["src/interfaces/**"]
      },
      {
        "name": "http-transport",
        "patterns": ["ui/http-transport.ts", "ui/write-transport.ts"]
      },
      {
        "name": "api-client",
        "patterns": ["ui/api.ts"]
      },
      {
        "name": "mutation-owner",
        "patterns": ["ui/use-mutation.ts"]
      },
      {
        "name": "ui",
        "patterns": ["ui/**"]
      },
      {
        "name": "examples",
        "patterns": ["examples/**"]
      },
      {
        "name": "tests",
        "patterns": ["test/**"]
      },
      {
        "name": "development-register",
        "patterns": ["scripts/register.mjs"]
      },
      {
        "name": "tooling",
        "patterns": ["eslint.config.js", "vite.config.ts", "playwright.config.ts", "scripts/**"]
      }
    ],
    "rules": [
      {
        "from": "public-api",
        "allow": ["core", "application"],
        "allowTypeOnly": ["repository-contract"]
      },
      {
        "from": "core",
        "allow": ["core"]
      },
      {
        "from": "application",
        "allow": ["core", "application"],
        "allowTypeOnly": ["repository-contract"]
      },
      {
        "from": "repository-contract",
        "allow": [],
        "allowTypeOnly": ["core"]
      },
      {
        "from": "persistence",
        "allow": ["core", "persistence"],
        "allowTypeOnly": ["repository-contract"]
      },
      {
        "from": "api-contract",
        "allow": ["core", "api-contract"],
        "allowTypeOnly": ["application", "interfaces"]
      },
      {
        "from": "interfaces",
        "allow": ["core", "application", "persistence", "interfaces", "api-contract"],
        "allowTypeOnly": ["repository-contract"]
      },
      {
        "from": "ui",
        "allow": ["core", "api-contract", "ui", "api-client", "mutation-owner"],
        "allowTypeOnly": ["application", "interfaces"]
      },
      {
        "from": "launcher",
        "allow": ["core", "application", "persistence", "interfaces", "examples"],
        "allowTypeOnly": ["repository-contract"]
      },
      {
        "from": "http-transport",
        "allow": ["core", "api-contract", "http-transport", "headless-client"]
      },
      {
        "from": "api-client",
        "allow": ["core", "api-contract", "http-transport"]
      },
      {
        "from": "mutation-owner",
        "allow": ["ui", "http-transport"]
      },
      {
        "from": "headless-client",
        "allow": ["core", "api-contract"]
      },
      {
        "from": "development-register",
        "allow": ["public-api", "core", "application", "persistence"]
      }
    ],
    "coverage": {
      "requireAllFiles": true,
      "allowUnmatched": []
    }
  },
  "rulePacks": ["config/fallow-policy.json"],
  "ignorePatterns": ["test/workbench/**"],
  "health": {
    "coverage": ".fallow/coverage/raw"
  }
}
