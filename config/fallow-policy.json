{
  "version": 1,
  "name": "tracer",
  "rules": [
    {
      "id": "portable-domain",
      "kind": "banned-import",
      "files": ["src/core/**", "src/application/**"],
      "specifiers": ["react", "react-dom"],
      "severity": "error",
      "message": "Keep domain/application code portable; inject platform capabilities through contracts."
    },
    {
      "id": "typed-http",
      "kind": "banned-call",
      "files": ["ui/**"],
      "exclude": ["ui/http-transport.ts"],
      "callees": ["fetch"],
      "severity": "error",
      "message": "Use the endpoint-typed read API or the shared mutation executor."
    },
    {
      "id": "production-only",
      "kind": "banned-import",
      "files": ["ui/**", "src/**"],
      "specifiers": [
        "../test",
        "../../test",
        "../../../test",
        "../../../../test",
        "../docs/ux-artifacts",
        "../../docs/ux-artifacts",
        "../../../docs/ux-artifacts",
        "../../../../docs/ux-artifacts",
        "../.local",
        "../../.local",
        "../../../.local",
        "../../../../.local"
      ],
      "severity": "error",
      "message": "Production code must not import tests, archived UX studies or private development data."
    }
  ]
}
