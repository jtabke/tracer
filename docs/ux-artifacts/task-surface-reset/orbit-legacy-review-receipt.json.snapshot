    "token": "{\"inputs\":[{\"entityId\":\"dcd68e7b-8c8b-48d6-adf1-2f4d2b1f8b83\",\"exists\":true,\"links\":[],\"source\":{\"fields\":{\"acceptance\":\"Invented duty profile; compare whole-product consumption and usable battery energy.\",\"notes\":\"Fictional native record for exploration. No actual device, source code, test execution, approval or release is represented.\",\"owner\":\"fictional example team\",\"statement\":\"Complete 60 minutes of the defined mixed navigation and cleaning profile on the selected battery configuration.\",\"status\":\"illustrative draft\",\"title\":\"Draft cleaning runtime target\"},\"id\":\"dcd68e7b-8c8b-48d6-adf1-2f4d2b1f8b83\",\"key\":\"TGT-02\",\"type\":\"target\",\"version\":1},\"state\":\"current\"},{\"entityId\":\"ab28fc04-d0d9-4dda-b7c6-b788c2b6a4c7\",\"exists\":true,\"links\":[],\"source\":{\"fields\":{\"acceptance\":\"Engineering allocation to investigate, not an engine-computed runtime guarantee.\",\"notes\":\"Fictional native record for exploration. No actual device, source code, test execution, approval or release is represented.\",\"owner\":\"fictional example team\",\"statement\":\"Allocate a draft average 60 W across the defined cleaning profile using the fictional 60 Wh usable-energy assumption; preserve reserve and profile assumptions.\",\"status\":\"illustrative draft\",\"title\":\"Whole-product energy allocation\"},\"id\":\"ab28fc04-d0d9-4dda-b7c6-b788c2b6a4c7\",\"key\":\"REQ-R03\",\"type\":\"requirement\",\"version\":1},\"state\":\"current\"},{\"entityId\":\"d754ff9b-9b2b-4a75-ac44-eb7e62a76d1e\",\"exists\":true,\"links\":[],\"source\":{\"fields\":{\"artifact\":\"Invented artifact controls/blower-profile.ts\",\"notes\":\"Fictional native record for exploration. No actual device, source code, test execution, approval or release is represented.\",\"owner\":\"fictional example team\",\"statement\":\"Example blower-control design increases the proposed maximum duty from its baseline profile to improve pickup. Review e